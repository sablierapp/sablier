{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/refs/heads/main/schemas/config.json",
    "release-type": "go",
    "bump-minor-pre-major": true,
    "separate-pull-requests": true,
    "changelog-sections": [
        {
            "type": "feat",
            "section": "Features"
        },
        {
            "type": "fix",
            "section": "Bug Fixes"
        },
        {
            "type": "perf",
            "section": "Performance Improvements"
        },
        {
            "type": "docs",
            "section": "Documentation"
        },
        {
            "type": "style",
            "section": "Styles"
        },
        {
            "type": "refactor",
            "section": "Code Refactoring"
        },
        {
            "type": "test",
            "section": "Tests"
        },
        {
            "type": "chore",
            "section": "Chores"
        }
    ],
    "packages": {
        ".": {
            "include-component-in-tag": false,
            "exclude-paths": [
                "client"
            ],
            "extra-files": [
                {
                    "type": "generic",
                    "path": "README.md"
                },
                {
                    "type": "generic",
                    "path": "docs/hugo.yaml"
                },
                {
                    "type": "generic",
                    "path": "examples/kubernetes/sablier.yaml"
                },
                {
                    "type": "generic",
                    "path": "examples/docker/compose.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/docker/socket-proxy.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/docker/remote.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/docker-swarm/sablier.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/podman/compose.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/podman/sablier.sh"
                },
                {
                    "type": "generic",
                    "path": "examples/proxmox-lxc/compose.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/systemd/Makefile"
                },
                {
                    "type": "generic",
                    "path": "examples/nomad/compose.yml"
                },
                {
                    "type": "generic",
                    "path": "examples/nomad/sablier.nomad.hcl"
                },
                {
                    "type": "generic",
                    "path": "examples/ecs/sablier.yaml"
                }
            ]
        },
        "client": {
            "component": "client",
            "include-component-in-tag": true,
            "tag-separator": "/",
            "version-file": "version.go"
        }
    }
}
